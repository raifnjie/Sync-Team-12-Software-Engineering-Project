# Server port (not 5000: macOS AirPlay Receiver uses it)
PORT=5001

# Security: Secret key for signing and verifying JSON Web Tokens (JWT)
# IMPORTANT: In production, generate a strong random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=super_secret_development_jwt_key_12345

# Allowed frontend origins for CORS (Cross-Origin Resource Sharing)
# In development, Vite runs on http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Database connection (Prisma / PostgreSQL)
# Create both databases first:  createdb sync_dev && createdb sync_test
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/sync_dev?schema=public"
# Used only by `npm test`; it is wiped and re-seeded on every run
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/sync_test?schema=public"

