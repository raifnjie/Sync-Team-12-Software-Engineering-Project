# Server Port
PORT=5000

# Security: Secret key for signing and verifying JSON Web Tokens (JWT)
# IMPORTANT: In production, generate a strong random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=super_secret_development_jwt_key_12345

# Allowed frontend origins for CORS (Cross-Origin Resource Sharing)
# In development, Vite runs on http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Database connection (Prisma / PostgreSQL)
# DATABASE_URL="postgresql://user:password@localhost:5432/sync_db?schema=public"

